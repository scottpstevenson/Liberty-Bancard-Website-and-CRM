diff --git a/migrations/0297_task2002_soflo_cursor_rewind.sql b/migrations/0297_task2002_soflo_cursor_rewind.sql
new file mode 100644
index 0000000..62bc8ff
--- /dev/null
+++ b/migrations/0297_task2002_soflo_cursor_rewind.sql
@@ -0,0 +1,14 @@
+-- Re-scan the initial South Florida range after correcting the priority
+-- selector's cursor boundary. The prior selector could advance past eligible
+-- rows that exceeded the 25-record microbatch limit within its 1000-row
+-- scan window. Terminal claims are excluded by filing number on the re-scan,
+-- so completed work is not repeated; retryable failures remain reachable.
+-- The production run was paused before this corrective migration.
+UPDATE sunbiz_bootstrap_runs
+SET soflo_high_water_entity_id = 0,
+    high_water_entity_id = GREATEST(remaining_high_water_entity_id, 0),
+    updated_at = now()
+WHERE id = 'default'
+  AND status = 'paused'
+  AND phase = 'south_florida'
+  AND soflo_high_water_entity_id > 0;
