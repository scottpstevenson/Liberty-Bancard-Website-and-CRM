      ORDER BY m.roi_score DESC,b.id ASC LIMIT ${maxBusinesses}
   `));
   await db.execute(sql`UPDATE sfp_stage_runs SET selected_count=${targets.length},updated_at=NOW() WHERE id=${String(stage.id)}::uuid`);
